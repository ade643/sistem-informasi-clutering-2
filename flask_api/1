from flask import Flask, request, jsonify
from flask_cors import CORS
import numpy as np


app = Flask(__name__)
CORS(app)

# ===============================
# NORMALISASI MINMAX MANUAL
# ===============================
def minmax_scale(data):
    # Konversi ke numpy array jika belum
    data_np = np.array(data, dtype=float)
    if data_np.ndim == 1: # Handle jika data hanya satu dimensi
        data_np = data_np.reshape(-1, 1)
    
    min_val = data_np.min(axis=0)
    max_val = data_np.max(axis=0)
    
    # Tambahkan epsilon untuk menghindari pembagian dengan nol
    denominator = max_val - min_val
    denominator[denominator == 0] = 1e-9
    
    scaled = (data_np - min_val) / denominator
    return scaled, min_val.tolist(), max_val.tolist()


def print_normalization(ids, vectors, data_scaled, min_val, max_val, limit=None, decimals=4):
    print("\n===== HASIL NORMALISASI MIN-MAX =====")
    print("Min per fitur:", [round(x, decimals) for x in min_val])
    print("Max per fitur:", [round(x, decimals) for x in max_val])

    show_n = min(limit, len(ids)) if limit is not None else len(ids)
    print(f"\nContoh {show_n} data pertama (ID | asli -> scaled):")
    for i in range(show_n):
        scaled_row = [round(float(x), decimals) for x in data_scaled[i]]
        print(f"- {ids[i]} | {vectors[i]} -> {scaled_row}")

    if limit is not None and len(ids) > limit:
        print(f"... ({len(ids) - limit} data tidak ditampilkan)")


def format_centroid_preview(values, show_n, decimals=4):
    preview = [f"{float(v):.{decimals}f}" for v in values[:show_n]]
    return f"[{', '.join(preview)}]"


def format_distance_list(values, decimals=4):
    return f"[{', '.join(f'{float(v):.{decimals}f}' for v in values)}]"

# ===============================
# HITUNG JARAK EUCLIDEAN
# ===============================
def euclidean(p1, p2):
    return np.sqrt(np.sum((np.array(p1) - np.array(p2)) ** 2))

def calinski_harabasz_score_manual(data_scaled, clusters, centroids):
    data_np = np.array(data_scaled, dtype=float)
    clusters_np = np.array(clusters, dtype=int)
    centroids_np = np.array(centroids, dtype=float)

    n_samples = data_np.shape[0]
    n_clusters = centroids_np.shape[0]

    if n_clusters <= 1 or n_samples <= n_clusters:
        return 0.0, 0.0, 0.0

    global_centroid = np.mean(data_np, axis=0)

    # SSW (Within-Cluster Sum of Squares)
    ssw = 0.0
    for i in range(n_samples):
        c_idx = clusters_np[i]
        ssw += float(np.sum((data_np[i] - centroids_np[c_idx]) ** 2))

    # SSB (Between-Cluster Sum of Squares)
    ssb = 0.0
    for c_idx in range(n_clusters):
        members = data_np[clusters_np == c_idx]
        n_k = members.shape[0]
        if n_k == 0:
            continue
        ssb += float(n_k * np.sum((centroids_np[c_idx] - global_centroid) ** 2))

    if ssw == 0:
        ch = 0.0
    else:
        ch = (ssb / (n_clusters - 1)) / (ssw / (n_samples - n_clusters))

    return ssb, ssw, float(ch)


# ===============================
# K-MEANS MANUAL
# ===============================
# Diperbarui untuk mengembalikan jarak setiap titik ke centroidnya
def kmeans_manual(data_scaled, ids, k, max_iter=300, verbose=True, show_first_n_features=3):
    data_scaled = np.array(data_scaled, dtype=float)
    n_samples = len(data_scaled)

    if k > n_samples:
        return [], [], 0, [], {}

    rng = np.random.default_rng(42)
    idx = rng.choice(n_samples, k, replace=False)      # indeks centroid awal
    centroids = data_scaled[idx].copy()

    clusters = np.zeros(n_samples, dtype=int)
    process_log = {
        "k": int(k),
        "n_samples": int(n_samples),
        "n_features": int(data_scaled.shape[1]),
        "initial_centroid_indices": idx.tolist(),
        "initial_centroids": centroids.tolist(),
        "iterations": [],
        "final_centroids": [],
        "converged_at_iteration": None,
        "total_iterations": 0
    }

    if verbose:
        print(f"\n--- Memulai Proses K-Means (K={k}) ---")
        print(f"Jumlah Cluster (K): {k}")
        print(f"Jumlah Data: {n_samples}")
        print(f"Jumlah Fitur: {data_scaled.shape[1]} Mata Pelajaran")

        print("\n>>> INISIALISASI (Centroid Awal):")
        print("Indeks data yang dipilih sebagai centroid awal:", idx.tolist())
        for c_idx, c_val in enumerate(centroids):
            potong = format_centroid_preview(c_val.tolist(), show_first_n_features, decimals=4)
            print(f"  Centroid {c_idx + 1}: {potong}...")

    for n_iter in range(max_iter):
        # Assign cluster
        distances_matrix = []
        for i, point in enumerate(data_scaled):
            distances = [euclidean(point, centroid) for centroid in centroids]
            distances_matrix.append(distances)
            clusters[i] = int(np.argmin(distances))

        # Update centroid (handle cluster kosong)
        new_centroids = centroids.copy()
        for ci in range(k):
            members = data_scaled[clusters == ci]
            if len(members) == 0:
                # re-init centroid jika cluster kosong
                new_centroids[ci] = data_scaled[int(rng.integers(0, n_samples))]
            else:
                new_centroids[ci] = members.mean(axis=0)

        # Hitung WCSS iterasi ini
        dists_iter = np.linalg.norm(data_scaled - new_centroids[clusters], axis=1)
        wcss_iter = float(np.sum(dists_iter ** 2))
        centroid_shift = float(np.linalg.norm(new_centroids - centroids))

        process_log["iterations"].append({
            "iteration": int(n_iter + 1),
            "wcss": wcss_iter,
            "centroids_before": centroids.tolist(),
            "centroids_after": new_centroids.tolist(),
            "centroid_shift": centroid_shift,
            "assignments": [
                {
                    "id": ids[i],
                    "cluster": int(clusters[i]),
                    "distance_to_assigned": float(distances_matrix[i][clusters[i]]),
                    "distances_to_centroids": [float(d) for d in distances_matrix[i]]
                }
                for i in range(n_samples)
            ]
        })

        if verbose:
            print(f"\n>>> ITERASI KE-{n_iter+1}")
            print(f"WCSS Iterasi: {wcss_iter:.6f}")
            for c_idx in range(k):
                n_member = int(np.sum(clusters == c_idx))
                before = format_centroid_preview(centroids[c_idx].tolist(), show_first_n_features, decimals=4)
                after = format_centroid_preview(new_centroids[c_idx].tolist(), show_first_n_features, decimals=4)
                print(f"  Centroid {c_idx + 1} ({n_member} anggota)")
                print(f"    sebelum: {before}...")
                print(f"    sesudah: {after}...")

        # Cek konvergensi
        if np.allclose(centroids, new_centroids, atol=1e-8):
            centroids = new_centroids
            process_log["converged_at_iteration"] = int(n_iter + 1)
            if verbose:
                print(f"\nKonvergensi tercapai pada iterasi ke-{n_iter+1}")
                print("\n>>> CENTROID FINAL (HASIL AKHIR):")
                for c_idx, c_val in enumerate(centroids):
                    potong = format_centroid_preview(c_val.tolist(), show_first_n_features, decimals=4)
                    print(f"  Centroid {c_idx + 1}: {potong}...")
                print()
            break

        centroids = new_centroids

    # Kalau tidak konvergen sampai max_iter, tetap tampilkan centroid final
    else:
        if verbose:
            print(f"\nMencapai max_iter={max_iter} tanpa konvergensi.")
            print("\n>>> CENTROID FINAL (HASIL AKHIR):")
            for c_idx, c_val in enumerate(centroids):
                potong = format_centroid_preview(c_val.tolist(), show_first_n_features, decimals=4)
                print(f"  Centroid {c_idx + 1}: {potong}...")
            print()

    process_log["final_centroids"] = centroids.tolist()
    process_log["total_iterations"] = len(process_log["iterations"])

    # Hitung WCSS final dan jarak individual
    final_dists = np.linalg.norm(data_scaled - centroids[clusters], axis=1)
    wcss = float(np.sum(final_dists ** 2))

    # Jarak final setiap data ke semua centroid (untuk logging terminal)
    final_distances_matrix = []
    for point in data_scaled:
        dists = [euclidean(point, centroid) for centroid in centroids]
        final_distances_matrix.append(dists)

    ssb, ssw, ch_index = calinski_harabasz_score_manual(data_scaled, clusters, centroids)

    if verbose:
        print(">>> JARAK EUCLIDEAN FINAL KE TIAP CENTROID")
        for i in range(n_samples):
            dists_str = format_distance_list(final_distances_matrix[i], decimals=4)
            assigned_cluster = int(clusters[i])
            assigned_cluster_display = assigned_cluster + 1
            assigned_dist = float(final_distances_matrix[i][assigned_cluster])
            print(
                f"- ID {ids[i]} | centroid={assigned_cluster_display} | "
                f"jarak_terpilih={assigned_dist:.4f} | semua_jarak={dists_str}"
            )

        print("\n>>> EVALUASI KUALITAS CLUSTERING (CALINSKI-HARABASZ)")
        print(f"SSB (Between-Cluster Sum of Squares): {ssb:.6f}")
        print(f"SSW (Within-Cluster Sum of Squares):  {ssw:.6f}")
        print(f"Calinski-Harabasz Index (CH):         {ch_index:.6f}\n")

    return clusters.tolist(), centroids.tolist(), wcss, final_dists.tolist(), process_log, ssb, ssw, ch_index



# ===============================
# ENDPOINT: CLUSTERING (SEBELUMNYA /kmeans)
# ===============================
@app.route('/clustering', methods=['POST'])
def process_clustering():
    try:
        body = request.json

        # Disesuaikan dengan request dari Node.js
        data_with_ids = body['data']
        k = int(body['n_clusters'])

        # Ekstrak vektor dan ID
        ids = [item['id'] for item in data_with_ids]
        vectors = [item['vector'] for item in data_with_ids]

        if not vectors:
            return jsonify({"error": "Data vektor tidak boleh kosong"}), 400

        # Normalisasi
        data_scaled, min_val, max_val = minmax_scale(vectors)

        # TAMPILKAN HASIL NORMALISASI DI TERMINAL
        print_normalization(ids, vectors, data_scaled, min_val, max_val, limit=None)

        # Proses k-means manual
        labels, centroids, wcss, distances, process_log, ssb, ssw, ch_index = kmeans_manual(
            data_scaled, ids, k, verbose=True, show_first_n_features=data_scaled.shape[1]
        )

        # Format hasil sesuai yang diharapkan Node.js
        results = []
        for i in range(len(ids)):
            results.append({
                "id": ids[i],
                "cluster": labels[i],
                "distance": distances[i]
            })

        return jsonify({
            "results": results,
            "centroids": centroids,
            "wcss": wcss,
            "ssb": ssb,
            "ssw": ssw,
            "calinski_harabasz": ch_index,
            "min_val": min_val,
            "max_val": max_val,
            "process": {
                "initial_data": [
                    {"id": ids[i], "vector": vectors[i]}
                    for i in range(len(ids))
                ],
                "normalized_data": [
                    {"id": ids[i], "vector": data_scaled[i].tolist()}
                    for i in range(len(ids))
                ],
                "kmeans": process_log
            },
            "message": "K-Means manual berhasil dijalankan"
        })

    except Exception as e:
        print(f"ERROR /clustering: {e}")
        return jsonify({"error": f"Terjadi kesalahan pada server: {e}"}), 500





if __name__ == "__main__":
    app.run(debug=True, port=5001)
